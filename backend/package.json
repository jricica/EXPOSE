{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "prestart": "npm run db:migrate:deploy",
    "start": "node dist/index.js",
    "build": "tsc",
    "db:test": "ts-node src/test-connection.ts",
    "db:init": "ts-node src/init-db.ts",
    "db:seed": "prisma db seed",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:baseline": "prisma migrate resolve --applied 20260419221500_init",
    "seed:test-users": "ts-node src/seed-test-users.ts",
    "feed:reconcile": "ts-node src/reconcile-feed.ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "docker:build": "docker build -t expose-backend .",
    "docker:run": "docker run -p 3000:3000 expose-backend",
    "health": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.400.0",
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/client-secrets-manager": "^3.400.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.37.0",
    "@types/multer": "^2.1.0",
    "@types/uuid": "^10.0.0",
    "aws-xray-sdk-express": "^3.5.0",
    "bcrypt": "^6.0.0",
    "cls-hooked": "^4.2.2",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql-promise": "^5.0.0",
    "mysql2": "^3.16.3",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cls-hooked": "^4.3.8",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.30",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.12.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node src/seed.ts"
  }
}
